# Copy this file to .env and fill in real values. .env is gitignored.

# Google Maps JavaScript API key with the "Places API (New)" enabled.
# Restrict it to your production domain(s) in the Google Cloud console.
# Leave empty to use the built-in mock address suggestions (local/dev).
GOOGLE_PLACES_KEY=

# ---- Operational logging -------------------------------------------------
# Structured file log for the lead pipeline (includes/logger.php).
# level: debug | info | warning | error. LOG_DIR defaults to <project>/logs.
LOG_LEVEL=debug
#LOG_DIR=

# Runtime environment: 'production' (default) or 'local'.
# 'local' makes submit.php SKIP Firebase ID-token verification so the funnel
# can be completed in dev without a real SMS OTP session. Use 'production'
# on staging/live so the phone verification is actually enforced.
APP_ENV=local

# ---- Database (lead storage) ---------------------------------------------
# MySQL/MariaDB connection (Cloudways). submit.php inserts each lead here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ---- Firebase Phone Auth (step 8 OTP) ------------------------------------
# Web app config from the Firebase console (Project settings → Your apps).
# api_key/auth_domain are shipped to the browser (not secret); project_id is
# used server-side to verify the ID token's aud/iss. Leave PROJECT_ID empty to
# disable the OTP gate entirely (dev only).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# ---- Compliance capture (TCPA proof-of-consent) --------------------------
# TrustedForm needs no key (script injects the cert URL). Set to 0 to disable.
TRUSTEDFORM_ENABLED=1
# Jornaya (LeadiD): both required to render the tag; leave empty to omit it.
JORNAYA_CAMPAIGN_ID=
JORNAYA_ACCOUNT_ID=

# ---- Equifax Consumer Credit Report --------------------------------------
# mode: off (skip, no log) | mock (synthetic response, writes a log row) | live
EQUIFAX_MODE=off
EQUIFAX_BASE_URL=https://api.equifax.com
EQUIFAX_CLIENT_ID=
EQUIFAX_CLIENT_SECRET=
EQUIFAX_MEMBER_NUMBER=
EQUIFAX_SECURITY_CODE=
EQUIFAX_SCOPE=https://api.equifax.com/business/consumer-credit/v1
EQUIFAX_TIMEOUT=15
# Optional dot-path to a precomputed total-debt figure in the report JSON
# (e.g. summary.totalDebt). Leave empty to sum trade-line balances instead.
EQUIFAX_TOTAL_DEBT_PATH=
# Set to 1 to mask the SSN in the stored request body (default 0 = full body).
EQUIFAX_REDACT=0
