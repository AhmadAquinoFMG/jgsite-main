# Copy this file to .env and fill in real values. .env is gitignored.

# Google Maps JavaScript API key with the "Places API (New)" enabled.
# Restrict it to your production domain(s) in the Google Cloud console.
# Leave empty to use the built-in mock address suggestions (local/dev).
GOOGLE_PLACES_KEY=

# ---- Operational logging -------------------------------------------------
# Structured file log for the lead pipeline (includes/logger.php).
# level: debug | info | warning | error. LOG_DIR defaults to <project>/logs.
LOG_LEVEL=debug
#LOG_DIR=

# Runtime environment: 'production' (default) or 'local'.
# 'local' relaxes production-only checks so the funnel can be exercised in dev.
APP_ENV=local

# ---- Database (lead storage) ---------------------------------------------
# MySQL/MariaDB connection (Cloudways). submit.php inserts each lead here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ---- Compliance capture (TCPA proof-of-consent) --------------------------
# TrustedForm needs no key (script injects the cert URL). Set to 0 to disable.
TRUSTEDFORM_ENABLED=1
# Jornaya (LeadiD): both required to render the tag; leave empty to omit it.
JORNAYA_CAMPAIGN_ID=
JORNAYA_ACCOUNT_ID=

# ---- Equifax Consumer Credit Report (OneView, OAuth2) --------------------
# mode: off (skip, no log) | mock (synthetic, writes a log row) | sandbox | production
EQUIFAX_MODE=off
# Credentials are chosen by mode. production -> EQUIFAX_PRODUCTION_*, else SANDBOX.
# The API key/secret ARE the OAuth client-credentials.
EQUIFAX_PRODUCTION_API_KEY=
EQUIFAX_PRODUCTION_API_SECRET=
EQUIFAX_SANDBOX_API_KEY=
EQUIFAX_SANDBOX_API_SECRET=
# Host + paths default per mode; override only if your account differs.
#EQUIFAX_API_BASE=https://api.equifax.com        # sandbox: https://api.sandbox.equifax.com
#EQUIFAX_TOKEN_PATH=/v2/oauth/token
#EQUIFAX_PRODUCT_PATH=/business/oneview/consumer-credit/v1/reports/credit-report
# IMPORTANT: leave SCOPE empty — this account 400s (invalid_scope) on an explicit
# scope and only issues a token when it is omitted. Set only if your account needs one.
EQUIFAX_SCOPE=
# Account identifiers (from your Equifax contract).
EQUIFAX_MEMBER_NUMBER=
EQUIFAX_SECURITY_CODE=
EQUIFAX_CUSTOMER_CODE=
EQUIFAX_ECOA_INQUIRY_TYPE=Individual
EQUIFAX_MULTIPLE_REPORT_INDICATOR=1
EQUIFAX_MODEL_ID=05734
EQUIFAX_TIMEOUT=20
# Optional dot-path to a precomputed total-debt figure in the report JSON
# (e.g. summary.totalDebt). Leave empty to sum trade-line balances instead.
EQUIFAX_TOTAL_DEBT_PATH=
# Set to 1 to mask the SSN in the stored request body (account secrets are
# always redacted regardless). Default 0.
EQUIFAX_REDACT=0
# Optional: absolute path to a CA-chain PEM to pin cURL's trust to. Leave empty
# to use curl's system CA bundle (TLS verification is always on regardless —
# this only picks which chain is trusted). Only set this to a path that
# actually exists on THIS server; a wrong/stale path fails every pull with
# "error setting certificate file".
EQUIFAX_CA_BUNDLE=

# ---- LeadProsper direct-post (lead distribution) --------------------------
# mode: off (skip, no log) | test (posts with lp_action=test, LP won't bill/
# deliver) | live. Get campaign/supplier id + key from your LeadProsper
# campaign's "Direct Post" instructions.
LEADPROSPER_MODE=off
LP_CAMPAIGN_ID=
LP_SUPPLIER_ID=
LP_KEY=
#LP_ENDPOINT=https://api.leadprosper.io/direct_post
#LP_TIMEOUT=20

# ---- Bot protection --------------------------------------------------------
# Minimum seconds between page render and submit before a lead is flagged as
# a bot (see docs/bot-protection.md). Default 4.
TIMING_MIN_SECONDS=4

# Create a widget at https://dash.cloudflare.com/ -> Turnstile -> Add Site.
# Leave TURNSTILE_ENABLED=0 to disable (no widget rendered, no server check).
TURNSTILE_ENABLED=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
#TURNSTILE_VERIFY_ENDPOINT=https://challenges.cloudflare.com/turnstile/v0/siteverify
#TURNSTILE_TIMEOUT=10

# ---- Everflow affiliate tracking (client-side click attribution) ----------
# Leave EVERFLOW_OFFER_ID empty to disable the tracking script entirely.
# Get offer_id/affiliate_id and the tracking domain from your Everflow offer.
EVERFLOW_OFFER_ID=
EVERFLOW_AFFILIATE_ID=
#EVERFLOW_DOMAIN=www.f0cg2trk.com

# ---- Funnel drop-off report → Slack (bin/funnel-slack-report.php) ----------
# CLI/cron only; nothing here is read by the web pages. Both keys are required
# or the report exits 1 without posting.
#
# Umami Cloud API key (Settings -> API keys). NOT the website id — the tag's
# website id lives in config.php ['umami'], and the report defaults to that same
# id, so UMAMI_WEBSITE_ID only needs setting to query a DIFFERENT property.
UMAMI_API_KEY=
#UMAMI_WEBSITE_ID=
#
# One or more Slack Incoming Webhook URLs, COMMA-SEPARATED — the digest is posted
# to every one of them. (SLACK_WEBHOOK_URLS is accepted as an alias.)
SLACK_WEBHOOK_URL=
