# Copy this file to .env and fill in real values. .env is gitignored.

# Google Maps JavaScript API key with the "Places API (New)" enabled.
# Restrict it to your production domain(s) in the Google Cloud console.
# Leave empty to use the built-in mock address suggestions (local/dev).
GOOGLE_PLACES_KEY=

# ---- Operational logging -------------------------------------------------
# Structured file log for the lead pipeline (includes/logger.php).
# level: debug | info | warning | error. LOG_DIR defaults to <project>/logs.
LOG_LEVEL=debug
#LOG_DIR=

# Runtime environment: 'production' (default) or 'local'.
# 'local' relaxes production-only checks so the funnel can be exercised in dev.
APP_ENV=local

# ---- Database (lead storage) ---------------------------------------------
# MySQL/MariaDB connection (Cloudways). submit.php inserts each lead here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ---- Compliance capture (TCPA proof-of-consent) --------------------------
# TrustedForm needs no key (script injects the cert URL). Set to 0 to disable.
TRUSTEDFORM_ENABLED=1
# Jornaya (LeadiD): both required to render the tag; leave empty to omit it.
JORNAYA_CAMPAIGN_ID=
JORNAYA_ACCOUNT_ID=

# ---- Equifax Consumer Credit Report (OneView, OAuth2) --------------------
# mode: off (skip, no log) | mock (synthetic, writes a log row) | sandbox | production
EQUIFAX_MODE=off
# Credentials are chosen by mode. production -> EQUIFAX_PRODUCTION_*, else SANDBOX.
# The API key/secret ARE the OAuth client-credentials.
EQUIFAX_PRODUCTION_API_KEY=
EQUIFAX_PRODUCTION_API_SECRET=
EQUIFAX_SANDBOX_API_KEY=
EQUIFAX_SANDBOX_API_SECRET=
# Host + paths default per mode; override only if your account differs.
#EQUIFAX_API_BASE=https://api.equifax.com        # sandbox: https://api.sandbox.equifax.com
#EQUIFAX_TOKEN_PATH=/v2/oauth/token
#EQUIFAX_PRODUCT_PATH=/business/oneview/consumer-credit/v1/reports/credit-report
# IMPORTANT: leave SCOPE empty — this account 400s (invalid_scope) on an explicit
# scope and only issues a token when it is omitted. Set only if your account needs one.
EQUIFAX_SCOPE=
# Account identifiers (from your Equifax contract).
EQUIFAX_MEMBER_NUMBER=
EQUIFAX_SECURITY_CODE=
EQUIFAX_CUSTOMER_CODE=
EQUIFAX_ECOA_INQUIRY_TYPE=Individual
EQUIFAX_MULTIPLE_REPORT_INDICATOR=1
EQUIFAX_MODEL_ID=05734
EQUIFAX_TIMEOUT=20
# Optional dot-path to a precomputed total-debt figure in the report JSON
# (e.g. summary.totalDebt). Leave empty to sum trade-line balances instead.
EQUIFAX_TOTAL_DEBT_PATH=
# Set to 1 to mask the SSN in the stored request body (account secrets are
# always redacted regardless). Default 0.
EQUIFAX_REDACT=0
