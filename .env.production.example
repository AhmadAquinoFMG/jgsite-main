# Copy to .env and fill in. Values here are placeholders, never real secrets.

APP_ENV=production
LOG_LEVEL=info
GOOGLE_PLACES_KEY=
GOOGLE_MAPS_API_KEY=

# ── JG Wentworth Lead Scoring (Debt Resolution) ───────────────────────────
# THE source of verified total debt (leads.total_debt / jgw_total_debt).
#   off  → skipped entirely, no log row
#   mock → synthetic response, no network, still logs — verify wiring safely
#   live → real POST. ⚠ CREATES A REAL LEAD AT JG. See README before enabling:
#          JG is also an LP buyer, and running both double-delivers the lead.
JGSCORING_MODE=live
JGSCORING_ENDPOINT=https://leadscoring.jgwentworth.com/api/leads/dr/
JGSCORING_TOKEN=
# 'Token' / 'Bearer' if JG's token needs a prefix; empty sends it verbatim.
JGSCORING_AUTH_SCHEME=
JGSCORING_TIMEOUT=20
JGSCORING_CAMPAIGN_SOURCE=
# Partner attribution echoed in additional_fields (defaults match JG's sample).
JGSCORING_UTM_SOURCE=FMGWhiteLabel-Posted
JGSCORING_LEAD_SOURCE_DETAIL=FMGWhiteLabel
JGSCORING_LEAD_SOURCE=Affiliate

# ── Equifax — DORMANT: nothing calls it. Leave off. ───────────────────────
EQUIFAX_MODE=off

# ── LeadProsper ──────────────────────────────────────────────────────────
LEADPROSPER_MODE=live
LP_CAMPAIGN_ID=
LP_SUPPLIER_ID=
LP_KEY=
LP_ENDPOINT=https://api.leadprosper.io/direct_post

# ── Tokens / database ────────────────────────────────────────────────────
TOKEN_SECRET=
TOKEN_TTL_SECONDS=300
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ── Zapier (CallGrid join) ───────────────────────────────────────────────
ZAPIER_ENABLED=0
ZAPIER_LEAD_WEBHOOK_URL=
ZAPIER_TIMEOUT=8
