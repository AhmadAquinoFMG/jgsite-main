# # =============================================================================
# # PRODUCTION / STAGING .env template — JG Wentworth Debt-Relief funnel
# #
# # Copy to `.env` on the server and fill in real values. `.env` is gitignored;
# # never commit filled-in secrets. config.php is the source of truth for what
# # each key does and its default.
# #
# # For LOCAL DEV use `.env.example` instead (APP_ENV=local, Equifax off, etc.).
# # =============================================================================

# # ---- Runtime ---------------------------------------------------------------
# # 'production' ENFORCES the Firebase phone-OTP gate in submit.php. Never ship
# # 'local' to a live host — it bypasses server-side token verification.
# APP_ENV=production

# # ---- Operational logging ---------------------------------------------------
# # Structured file log for the lead pipeline (includes/logger.php).
# # level: debug | info | warning | error. In production 'info' is a good default.
# # LOG_DIR defaults to <project>/logs (gitignored) — set an absolute path to log
# # outside the web root if you prefer.
# LOG_LEVEL=info
# #LOG_DIR=/home/master/applications/<app>/logs

# # ---- Google Places (address autocomplete, step 5) -------------------------
# # Google Maps JS API key with "Places API (New)" enabled. Restrict it to your
# # production domain(s) in the Google Cloud console.
# GOOGLE_PLACES_KEY=AIzaSyA9DiggWsawF9hLRIxw_-jMhttV7KGvEs8

# # ---- Database (lead storage) ----------------------------------------------
# # MySQL/MariaDB. On Cloudways: Application > Access Details.
# # Import sql/schema.sql once to create the `leads` + `equifax_logs` tables.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=rfngzzgjev
# DB_USER=rfngzzgjev
# DB_PASS=W7WN8Az4Fk

# # ---- Firebase Phone Auth (step 9 OTP) -------------------------------------
# # Firebase console > Project settings > General > Your apps (Web app).
# # api_key/auth_domain are NOT secret (they ship to the browser); project_id is
# # what submit.php verifies the ID token against. Also: enable the Phone sign-in
# # provider and add your domain under Auth > Settings > Authorized domains.
# # Leave PROJECT_ID empty to DISABLE the OTP gate (not recommended in prod).
# FIREBASE_API_KEY=AIzaSyCs6f0iNKiPqVH7edRcmQ6jy2qzvkwgRoE
# FIREBASE_AUTH_DOMAIN=fitz-media-group.firebaseapp.com
# FIREBASE_PROJECT_ID=fitz-media-group
# FIREBASE_APP_ID=1:831934480658:web:11d966e4dfad59875a73cb
# FIREBASE_MESSAGING_SENDER_ID=831934480658

# # ---- Compliance capture (TCPA proof-of-consent) ---------------------------
# # TrustedForm needs no key — just the toggle (1 = on). The script injects the
# # hidden xxTrustedFormCertUrl that submit.php stores.
# TRUSTEDFORM_ENABLED=1
# # Jornaya (LeadiD): BOTH required to render the tag; leave blank to omit it.
# JORNAYA_CAMPAIGN_ID=
# JORNAYA_ACCOUNT_ID=

# # ---- Equifax Consumer Credit Report ---------------------------------------
# # Values come from your Equifax developer/contract package.
# #   mode: off (skip, no log) | mock (synthetic response, writes a log row) | live
# # ⚠ Before setting 'live', confirm base_url + endpoint paths + request schema
# #   in includes/equifax.php against your actual Equifax contract.
# EQUIFAX_MODE=production
# EQUIFAX_PRODUCTION_API_KEY=2HLHOEtxM3NDK4kmdM7zlwDTA0H0vqnm
# EQUIFAX_PRODUCTION_API_SECRET=BUA5zgnlIafs9B21
# EQUIFAX_MEMBER_NUMBER=416FZ02115
# EQUIFAX_SECURITY_CODE=F4R
# EQUIFAX_CUSTOMER_CODE=IAPI
# EQUIFAX_ECOA_INQUIRY_TYPE=Individual
# EQUIFAX_MULTIPLE_REPORT_INDICATOR=1
# EQUIFAX_SCOPE=https://api.equifax.com/business/consumer-credit/v1
# EQUIFAX_TIMEOUT=15
# # ⚠ 0 stores the FULL SSN + raw credit report in equifax_logs (cleartext).
# #   Set 1 to mask the SSN in the stored request body. Restrict DB access and
# #   set a retention policy regardless.
# EQUIFAX_REDACT=0
