# ---------------------------------------------------------------------------
# Lead Portal — server-level hardening.
#
# The application enforces all of this itself (auth.php gates every page and the
# pages set their own headers). This file is the belt to that pair of braces:
# it also covers responses PHP never generates, like a directory listing or a
# stray file served straight off disk.
# ---------------------------------------------------------------------------

# Never index the admin area. The PROJECT ROOT .htaccess strips X-Robots-Tag to
# let each funnel page decide indexing via its meta tag — that strip applies
# here too, so the header has to be set back afterwards. Child directives run
# after the parent's, so this wins.
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# No directory listing — admin/includes/ and admin/assets/ must not be browsable.
Options -Indexes

# The include files are required by the page scripts, never requested directly.
# Hitting includes/auth.php over HTTP would execute it with no config loaded;
# harmless today, but there is no reason for it to be reachable at all.
<FilesMatch "^(auth|audit|layout|leadquery|postquery)\.php$">
    Require all denied
</FilesMatch>
